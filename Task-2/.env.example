# Discord Application
DISCORD_PUBLIC_KEY=your_discord_application_public_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# AWS
DYNAMODB_MEAL_TABLE=mhp-meal-records
DYNAMODB_USER_HISTORY_TABLE=mhp-user-history
AWS_REGION=ap-southeast-1

# Discord Role IDs
ROLE_TEAM_LEAD_ID=your_team_lead_role_id_here
ROLE_ADMIN_ID=your_admin_role_id_here

# Guild Authorization
AUTHORIZED_GUILD_ID=your_discord_guild_id_here

# Timezone & Cut-off
TIMEZONE=Asia/Dhaka
DEFAULT_CUTOFF_TIME=00:00

# Internal API (dashboard)
INTERNAL_API_KEY=your_internal_api_key_here
